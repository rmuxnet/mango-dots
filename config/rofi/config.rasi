* {
    bg: rgba(10, 10, 10, 88%);
    bg-alt: rgba(26, 26, 26, 95%);
    fg: #f5f5f7;
    fg-alt: #8a8a8e;
    accent: #CBA6F7;
    urgent: #ff5252;

    background-color: @bg;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
    width: 520px;
    padding: 16px;
    location: center;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, mode-switcher, listview ];
    spacing: 12px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 10px;
    margin: 0px;
    spacing: 0px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @accent;
    padding: 0px 10px 0px 4px;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search...";
    placeholder-color: @fg-alt;
    blink: true;
}

mode-switcher {
    background-color: transparent;
    spacing: 4px;
}

button {
    background-color: @bg-alt;
    text-color: @fg-alt;
    border-radius: 8px;
    padding: 6px 14px;
    cursor: pointer;
}

button selected {
    background-color: @accent;
    text-color: #ffffff;
}

listview {
    background-color: transparent;
    lines: 7;
    fixed-height: false;
    scrollbar: false;
    spacing: 2px;
}

element {
    background-color: transparent;
    text-color: @fg;
    border-radius: 8px;
    padding: 8px;
    margin: 0px;
    spacing: 10px;
}

element normal normal {
    background-color: transparent;
    text-color: @fg;
}

element normal active {
    background-color: transparent;
    text-color: @accent;
}

element normal urgent {
    background-color: transparent;
    text-color: @urgent;
}

element alternate normal {
    background-color: transparent;
    text-color: @fg;
}

element selected normal {
    background-color: @accent;
    text-color: #ffffff;
}

element selected active {
    background-color: @accent;
    text-color: #ffffff;
}

element selected urgent {
    background-color: @urgent;
    text-color: #ffffff;
}

element-icon {
    background-color: transparent;
    size: 1.2em;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
