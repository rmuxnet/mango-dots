* {
    bg: #0a0a0ae6;
    bg-alt: #1c1c1f;
    fg: #e8e6ef;
    fg-alt: #6c6c74;
    accent: #CBA6F7;
    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    location: center;
    width: 520px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 0px;
    padding: 0px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 0px;
}

inputbar {
    children: [ prompt, entry ];
    padding: 12px 14px;
    background-color: @bg-alt;
    spacing: 10px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "run";
    placeholder-color: @fg-alt;
}

listview {
    lines: 8;
    fixed-height: true;
    scrollbar: false;
    padding: 6px 0px;
    spacing: 0px;
}

element {
    padding: 7px 14px;
    spacing: 10px;
    border: 0px 0px 0px 2px;
    border-color: transparent;
}

element normal.normal, element alternate.normal {
    text-color: @fg-alt;
}

element selected.normal {
    background-color: @bg-alt;
    text-color: @accent;
    border-color: @accent;
}

element-icon {
    size: 1.1em;
}

element-text {
    text-color: inherit;
}
