{
    "logo": {
        "source": "arch_small",
        "color": { "1": "magenta", "2": "magenta" },
        "padding": { "top": 1, "left": 2, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "magenta", "title": "magenta" },
        "key": { "width": 8 }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name}" },
        { "type": "os", "key": "os", "format": "{name}" },
        { "type": "host", "key": "host", "format": "{name}" },
        { "type": "kernel", "key": "kernel", "format": "{release}" },
        { "type": "uptime", "key": "uptime" },
        { "type": "packages", "key": "pkgs", "format": "{all}" },
        { "type": "wm", "key": "wm", "format": "{pretty-name}" },
        { "type": "terminal", "key": "term", "format": "{pretty-name}" },
        { "type": "cpu", "key": "cpu", "format": "{name} ({cores-logical})" },
        { "type": "gpu", "key": "gpu", "format": "{name}" },
        { "type": "memory", "key": "memory", "format": "{used} / {total}" },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
    ]
}
